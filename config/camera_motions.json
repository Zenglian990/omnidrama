{
  "camera_motions": {
    "zoom_in": {
      "name": "镜头推进",
      "description": "焦点向画面中心缓慢推近，强化紧张与压迫感",
      "filter_expr": "zoompan=z='min(zoom+0.0015,1.2)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d={total_frames}:s={width}x{height}:fps={fps}"
    },
    "zoom_out": {
      "name": "镜头拉远",
      "description": "画面由局部特写缓慢拉至全局，展现全景反转",
      "filter_expr": "zoompan=z='if(lte(zoom,1.0),1.2,max(1.001,zoom-0.0015))':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d={total_frames}:s={width}x{height}:fps={fps}"
    },
    "pan_left": {
      "name": "向左横移",
      "description": "镜头从右向左匀速扫过，营造侦查或人物审视感",
      "filter_expr": "zoompan=z=1.15:x='if(lte(on,-1),(iw-iw/zoom)/2,max(0,(iw-iw/zoom)-(on/{total_frames})*(iw-iw/zoom)))':y='(ih-ih/zoom)/2':d={total_frames}:s={width}x{height}:fps={fps}"
    },
    "pan_right": {
      "name": "向右横移",
      "description": "镜头从左向右匀速扫过，带出登场角色",
      "filter_expr": "zoompan=z=1.15:x='min(iw-iw/zoom,(on/{total_frames})*(iw-iw/zoom))':y='(ih-ih/zoom)/2':d={total_frames}:s={width}x{height}:fps={fps}"
    },
    "shake": {
      "name": "镜头震撼/颤抖",
      "description": "模拟受到冲击、重击或情绪极度震惊的轻微晃动",
      "filter_expr": "crop=in_w-20:in_h-20:10+sin(n*1.5)*6:10+cos(n*2)*6,scale={width}:{height}"
    },
    "static": {
      "name": "静止镜头",
      "description": "保持画面平稳展现",
      "filter_expr": "scale={width}:{height}"
    }
  }
}
